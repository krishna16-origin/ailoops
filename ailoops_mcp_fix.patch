+def _mcp_scope(x_client_id: Optional[str]) -> str:
+    """Resolve which browser/device is making an MCP settings request.
+
+    All MCP server state (enabled/disabled toggles, custom registered servers)
+    used to live in one flat, process-wide dict with no notion of "whose"
+    setting it was — so toggling Wikipedia off in one browser silently toggled
+    it off for every other open browser/device hitting the same backend.
+    The frontend now sends a per-device id (generated once, persisted in
+    localStorage) as the `x-client-id` header on every /mcp/servers* call; we
+    fall back to a shared "default" scope only for old clients / direct API
+    calls that don't send it, so behavior stays backward compatible.
+    """
+    return (x_client_id or "").strip() or mcp_gateway._DEFAULT_SCOPE
+
