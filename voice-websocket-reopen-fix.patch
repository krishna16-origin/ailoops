diff --git a/test_voice_ws.py b/test_voice_ws.py
index b15842c..ba90a86 100644
--- a/test_voice_ws.py
+++ b/test_voice_ws.py
@@ -112,5 +112,63 @@ class VoiceHelpersTests(unittest.TestCase):
         self.assertTrue(any(event["type"] == "error" for event in events))
 
 
+async def hello_stream(_session):
+    yield "Hello there, friend."
+
+
+async def tiny_tts(_text, _voice):
+    yield b"\x01\x00" * 120
+
+
+class VoiceReopenTests(unittest.TestCase):
+    """Every click on voice mode is a brand-new socket that must reply."""
+
+    def _client(self, sessions):
+        from fastapi import FastAPI
+        from fastapi.testclient import TestClient
+
+        deps = voice_ws.VoiceDeps(
+            get_session=lambda sid: sessions.setdefault(sid, {"messages": []}),
+            trim_memory=lambda messages, **kwargs: messages,
+            llm_stream=hello_stream,
+            human_message=lambda text: ("human", text),
+            ai_message=lambda text: ("ai", text),
+            tts_pcm=tiny_tts,
+        )
+        app = FastAPI()
+        app.include_router(voice_ws.create_router(deps))
+        return TestClient(app)
+
+    def _one_exchange(self, client, session_id):
+        with client.websocket_connect("/ws/voice") as ws:
+            ws.send_json({"type": "config", "session_id": session_id})
+            self.assertEqual(ws.receive_json()["type"], "ready")
+            ws.send_json({"type": "text", "text": "hi"})
+            audio_turns, done = [], None
+            while done is None:
+                msg = ws.receive()
+                if msg.get("bytes") is not None:
+                    audio_turns.append(int.from_bytes(msg["bytes"][1:5], "big"))
+                elif msg.get("text") is not None:
+                    event = json.loads(msg["text"])
+                    if event["type"] == "turn_done":
+                        done = event
+            return audio_turns, done
+
+    def test_each_new_socket_replies_with_its_own_turn_numbering(self):
+        sessions = {}
+        client = self._client(sessions)
+        for _ in range(4):  # open -> reply -> close, repeated in the same chat session
+            audio_turns, done = self._one_exchange(client, "same-session")
+            self.assertEqual(done["response"], "Hello there, friend.")
+            self.assertTrue(audio_turns, "reply must include audio")
+            # The server restarts turn numbering at 1 on every new socket, which
+            # is why the browser has to reset its turn bookkeeping per socket.
+            self.assertEqual(set(audio_turns), {1})
+            self.assertEqual(done["turn"], 1)
+        # History keeps accumulating in the shared chat session across sockets.
+        self.assertEqual(len(sessions["same-session"]["messages"]), 8)
+
+
 if __name__ == "__main__":
     unittest.main()
