+import asyncio
 import pathlib
 import unittest
+import unittest.mock
+from unittest.mock import AsyncMock
+
+from langchain_core.messages import AIMessage
 
 import app
 
 
+class Nvidia429Error(Exception):
+    """Mimics the shape of a real NVIDIA/OpenAI 429 error."""
+    status_code = 429
+
+
+class _FakeLLM:
+    """Minimal stand-in for ChatNVIDIA — enough for invoke_model()'s ainvoke/
+    astream calls without touching the network.
+
+    `attempts` is a list consumed one per call: an Exception instance to be
+    raised, or a string to be returned/yielded as content. Each entry is used
+    for exactly one ainvoke() call or one astream() iteration.
+    """
+
+    def __init__(self, attempts):
+        self._attempts = list(attempts)
+        self._calls = 0
+
+    async def ainvoke(self, messages, **kwargs):
+        self._calls += 1
+        outcome = self._attempts.pop(0)
+        if isinstance(outcome, Exception):
+            raise outcome
+        return AIMessage(content=outcome)
+
+    async def astream(self, messages, **kwargs):
+        self._calls += 1
+        outcome = self._attempts.pop(0)
+        if isinstance(outcome, Exception):
+            raise outcome
+        yield AIMessage(content=outcome)
+
+
 class ModelRoutingTests(unittest.TestCase):
     def test_chat_deepseek_uses_current_nvidia_id(self):
         llm = app.get_llm("fast", 0.2, 128)
@@ -112,5 +150,55 @@ class ModelRoutingTests(unittest.TestCase):
             self.assertEqual(llm.temperature, 1.0)
 
 
+class KimiFallbackTests(unittest.IsolatedAsyncioTestCase):
+    """Covers the 429 fallback added to invoke_model(): once a model's own
+    retries are exhausted with a persistent 429 (the exact failure mode
+    reported for Kimi K3 on NVIDIA's free trial API catalog), invoke_model()
+    should hand off to the given fallback model instead of raising."""
+
+    async def asyncSetUp(self):
+        # invoke_model()'s backoff sleeps for real seconds between retries —
+        # skip that in tests so this suite stays fast.
+        patcher = unittest.mock.patch("app.asyncio.sleep", new=AsyncMock(return_value=None))
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    async def test_non_streaming_falls_back_after_exhausting_429_retries(self):
+        primary = _FakeLLM([Nvidia429Error()] * 4)  # every retry 429s
+        fallback = _FakeLLM(["fallback answer"])
+        result = await app.invoke_model([], primary, fallback_llm=fallback)
+        self.assertEqual(result, "fallback answer")
+        self.assertEqual(primary._calls, 4)  # 1 try + 3 retries, all exhausted
+        self.assertEqual(fallback._calls, 1)
+
+    async def test_non_streaming_recovers_without_fallback_if_retry_succeeds(self):
+        primary = _FakeLLM([Nvidia429Error(), "primary answer"])
+        fallback = _FakeLLM(["should not be used"])
+        result = await app.invoke_model([], primary, fallback_llm=fallback)
+        self.assertEqual(result, "primary answer")
+        self.assertEqual(fallback._calls, 0)
+
+    async def test_non_streaming_raises_when_no_fallback_given(self):
+        primary = _FakeLLM([Nvidia429Error()] * 4)
+        with self.assertRaises(Nvidia429Error):
+            await app.invoke_model([], primary, fallback_llm=None)
+
+    async def test_streaming_falls_back_after_exhausting_429_retries(self):
+        primary = _FakeLLM([Nvidia429Error()] * 4)
+        fallback = _FakeLLM(["fallback stream answer"])
+        progress = asyncio.Queue()
+        result = await app.invoke_model([], primary, progress, fallback_llm=fallback)
+        self.assertEqual(result, "fallback stream answer")
+        self.assertEqual(fallback._calls, 1)
+
+    async def test_fallback_client_is_a_much_smaller_model(self):
+        # Guards the actual production wiring: the fallback must not be
+        # another large reasoning model prone to the same capacity limits.
+        fallback = app._get_fallback_llm(8000)
+        self.assertEqual(fallback.model, app.FALLBACK_MODEL)
+        self.assertNotIn("kimi", fallback.model.lower())
+        self.assertNotIn("deepseek", fallback.model.lower())
+
+
 if __name__ == "__main__":
     unittest.main()
