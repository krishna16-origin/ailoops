+# NVIDIA's build.nvidia.com API catalog is a free trial/evaluation endpoint,
+# not a paid production tier. Its per-model capacity for large, in-demand
+# models like Kimi K3 and DeepSeek is shared across every developer using the
+# catalog worldwide, and multiple independent reports (NVIDIA's own developer
+# forum, e.g. "Kimi K2.6 is rate limited to 30 requests per hour") confirm
+# these specific models can return persistent 429s even for a single caller
+# making just a handful of requests, well below the account's advertised
+# per-minute limit, and even after the normal exponential-backoff retries in
+# invoke_model() are exhausted. Retrying harder doesn't fix a capacity ceiling
+# on NVIDIA's side, so when a long-running reasoning model still 429s after
+# every retry we fall back to a smaller, far less contended model instead of
+# surfacing a raw error to the user.
+FALLBACK_MODEL = "google/gemma-4-31b-it"
+FALLBACK_MAX_TOKENS = 8192
+
 # ChatNVIDIA builds both requests and aiohttp clients. A zero timeout disables
 # aiohttp reads but is invalid for requests, so use a long valid transport
 # window for models that may spend a long time thinking before their next chunk.
@@ -120,6 +135,15 @@ def _get_chat_nvidia_client(model_name: str, temperature: float, max_tokens: int
     return client
 
 
+def _get_fallback_llm(max_tokens: int) -> ChatNVIDIA:
+    """Backup model used when Kimi/DeepSeek keep 429ing after every retry.
+    Gemma is a much smaller, GA model on the same NIM catalog and is not
+    subject to the same capacity-driven rate limiting as the big reasoning
+    models, so it's a safe last resort to still give the user an answer."""
+    capped = max(1, min(int(max_tokens or 1024), FALLBACK_MAX_TOKENS))
+    return _get_chat_nvidia_client(FALLBACK_MODEL, 0.7, capped, 300)
+
