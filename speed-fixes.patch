@@ -1172,7 +1173,14 @@ async def generate_response_once(request: "ChatRequest", session: dict, progress
 
 
 
-app = FastAPI(title="AI Assistant")
+# ORJSONResponse is a drop-in for FastAPI's default (stdlib json-based)
+# JSONResponse: same dict/list/str/int/etc. input, but serializes in a
+# native Rust extension instead of pure Python, which is the standard
+# "make FastAPI JSON responses fast" lever. Only affects plain JSON
+# endpoints (session/file listings, MCP config, the non-streaming /chat
+# reply, etc.) — every SSE endpoint below builds its own StreamingResponse
+# and is untouched by this.
+app = FastAPI(title="AI Assistant", default_response_class=ORJSONResponse)
 
 app.add_middleware(
     CORSMiddleware,
@@ -1182,6 +1190,15 @@ app.add_middleware(
     allow_headers=["*"],
 )
 
+# Compresses text-based responses (the ~350KB frontend HTML, JSON API
+# replies) before they go over the wire — typically a 70-80% size cut for
+# text, which is most of what makes the page's first load feel slow on a
+# real connection. Starlette's GZipMiddleware already excludes
+# text/event-stream (and images) by content-type, so this never touches
+# the SSE chat/agent streams below — live token-by-token output is
+# unaffected either way.
+app.add_middleware(GZipMiddleware, minimum_size=1000)
+
 # Static frontend served after middleware so CORS headers apply correctly.
 app.mount("/frontend", StaticFiles(directory="frontend", html=True), name="frontend")
 
@@ -3012,6 +3029,19 @@ async def chat(request: ChatRequest):
     }
 
 
+# Fallback static mount for root-relative asset paths that index.html
+# actually requests — e.g. <link href="/icon.png"> and logo images
+# referenced as "logos/kimi.svg" (which resolve to /logos/kimi.svg against
+# the page's "/" URL, not /frontend/logos/kimi.svg). Those previously 404'd
+# on every load because only /frontend/* was mounted, which silently broke
+# the favicon and every model-picker logo image and cost a wasted
+# round trip per broken request. Starlette matches routes in registration
+# order, so placing this mount dead last means every API route and the
+# explicit "/" handler above still wins for its own path; this only ever
+# serves paths nothing else claimed.
+app.mount("/", StaticFiles(directory="frontend"), name="frontend_root")
+
+
 if __name__ == "__main__":
