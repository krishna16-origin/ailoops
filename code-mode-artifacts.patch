+ASSET_MAX_BYTES = 25 * 1024 * 1024
+
+
+def _safe_project_rel(rel_path: str) -> str:
+    """Normalize a project-relative path and reject anything that escapes the
+    project dir (absolute paths, '..' segments, empty names)."""
+    rel = (rel_path or "").strip().replace("\\", "/")
+    if not rel or rel.startswith("/") or any(seg in ("", "..", ".") for seg in rel.split("/")):
+        raise ValueError(f"invalid project path: {rel_path!r}")
+    return rel
+
+
+async def write_project_asset(session_id: str, rel_path: str, data: bytes) -> str:
+    """Write one binary asset (image, model, font, ...) into the sandbox
+    project dir. Returns the path inside the project.
+
+    Assets are deliberately NOT recorded in state.file_hashes: sync_files
+    treats any tracked path missing from the text file store as deleted, so
+    tracking a binary here would make the next sync remove it.
+    """
+    if len(data) > ASSET_MAX_BYTES:
+        raise ValueError("asset is larger than 25 MB")
+    safe = _safe_project_rel(rel_path)
+    state = await ensure_session(session_id)
+    async with state.lock:
+        dest = f"{PROJECT_DIR}/{safe}"
+        await state.sandbox.commands.run(
+            f'mkdir -p "$(dirname {shlex.quote(dest)})"', timeout=20
+        )
+        await state.sandbox.files.write(dest, data)
+    return safe
+
+
 async def sync_files(session_id: str, file_store: Dict[str, str]) -> List[str]:
     """Write only new/changed files into the sandbox project dir and remove
     ones no longer in file_store. Returns the list of paths actually written."""
