@@ -0,0 +1,74 @@
+"""Tests for code_artifacts. Run: python3 -m pytest test_code_artifacts.py -q
+(or: python3 test_code_artifacts.py)"""
+
+import code_artifacts as ca
+
+
+def test_classify_asset_kinds():
+    assert ca.classify_asset("hero.PNG") == "image"
+    assert ca.classify_asset("models/chair.glb") == "model3d"
+    assert ca.classify_asset("Inter.woff2") == "font"
+    assert ca.classify_asset("intro.mp4") == "video"
+    assert ca.classify_asset("app.jsx") is None
+    assert ca.classify_asset("") is None
+
+
+def test_asset_usage_prompt_requires_wiring():
+    prompt = ca.asset_usage_prompt("chair.glb")
+    assert "model3d" in prompt
+    assert "public/assets/models/chair.glb" in prompt
+    assert "Do not only copy the file" in prompt
+
+
+def test_intent_problem_report_is_fix():
+    assert ca.request_intent("the page is broken, fix it") == "fix"
+    assert ca.request_intent("I get a TypeError traceback") == "fix"
+
+
+def test_intent_all_files_wins_over_fix():
+    assert ca.request_intent("show all files, also there is a bug") == "list_all"
+    assert ca.request_intent("list the files of the repo") == "list_all"
+
+
+def test_intent_normal():
+    assert ca.request_intent("add a dark mode toggle") == "normal"
+    assert ca.request_intent("") == "normal"
+
+
+def test_fix_shows_only_touched_plus_named_files():
+    repo = ["src/App.jsx", "src/Nav.jsx", "README.md"]
+    touched = {"src/App.jsx": "..."}
+    out = ca.select_files_for_response("fix", touched, repo, "error in src/Nav.jsx:12")
+    assert out == ["src/App.jsx", "src/Nav.jsx"]
+    # README must NOT appear: nothing about it was touched or named.
+    assert "README.md" not in out
+
+
+def test_normal_shows_only_touched():
+    repo = ["src/App.jsx", "src/Nav.jsx"]
+    out = ca.select_files_for_response("normal", {"src/Nav.jsx": "x"}, repo, "add a button")
+    assert out == ["src/Nav.jsx"]
+
+
+def test_list_all_returns_everything_once():
+    repo = ["src/App.jsx", "src/Nav.jsx"]
+    out = ca.select_files_for_response("list_all", {"src/App.jsx": "x"}, repo, "show all files")
+    assert out == ["src/App.jsx", "src/Nav.jsx"]
+
+
+def test_repo_summary_excludes_full_tree():
+    files = [f"src/comp{i}.jsx" for i in range(500)] + ["README.md"]
+    summary = ca.summarize_repo(files, readme="# Hello\n" + "x" * 5000)
+    assert "501 files" in summary
+    assert "src/comp499.jsx" not in summary  # no full listing
+    assert "Full file list is available on request." in summary
+    assert len(summary) < 2500
+
+
+if __name__ == "__main__":
+    import sys
+    fns = [v for k, v in dict(globals()).items() if k.startswith("test_")]
+    for fn in fns:
+        fn()
+    print(f"{len(fns)} tests passed")
+    sys.exit(0)
