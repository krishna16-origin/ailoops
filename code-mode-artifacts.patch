+@app.post("/project-asset")
+async def project_asset(session_id: str = Form(...), file: UploadFile = File(...)):
+    """Place one asset from the Artifacts panel's Assets tab into the session's
+    sandbox project, under the folder for its kind, so the agent can wire it
+    in. Only this endpoint writes assets into the project: composer '+'
+    uploads go to /upload (RAG context) and never reach the project."""
+    filename = os.path.basename(file.filename or "")
+    kind = code_artifacts.classify_asset(filename)
+    if not filename or kind is None:
+        return JSONResponse({"error": "Not a supported asset type."}, status_code=400)
+    data = await file.read()
+    rel = f"{code_artifacts.DEFAULT_ASSET_DIR[kind]}/{filename}"
+    try:
+        path = await sandbox_manager.write_project_asset(session_id, rel, data)
+    except sandbox_manager.SandboxNotConfigured:
+        return JSONResponse({"error": "Sandbox is not configured."}, status_code=503)
+    except ValueError as exc:
+        return JSONResponse({"error": str(exc)}, status_code=400)
+    return {"path": path, "kind": kind}
+
+
