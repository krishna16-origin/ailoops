+"""Code-mode artifact helpers.
+
+Pure functions only (no I/O, no network), so they are cheap to test and safe
+to call from both the agent loop and the repo-fetch path.
+
+Concepts:
+- Assets: binary/media resources a user drops into a project (images, 3D
+  models, fonts, video, audio, data). The agent must actually wire an asset
+  into the code once it is placed, so each asset gets a usage prompt.
+- Intent: what the user's message is asking for. A problem report ("error",
+  "bug", "fix") narrows the file list to what was edited/fixed. Only an
+  explicit request for all files (or the whole tree) returns the repo listing.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from typing import Dict, Iterable, List, Optional, Sequence
+
+# ---------------------------------------------------------------------------
+# Asset classification
+# ---------------------------------------------------------------------------
+
+ASSET_KINDS: Dict[str, Sequence[str]] = {
+    "image": (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".avif", ".ico"),
+    "model3d": (".glb", ".gltf", ".obj", ".fbx", ".stl", ".usdz", ".ply"),
+    "font": (".woff", ".woff2", ".ttf", ".otf"),
+    "video": (".mp4", ".webm", ".mov"),
+    "audio": (".mp3", ".wav", ".ogg", ".m4a"),
+    "data": (".csv", ".json", ".geojson", ".xlsx"),
+}
+
+_EXT_TO_KIND: Dict[str, str] = {
+    ext: kind for kind, exts in ASSET_KINDS.items() for ext in exts
+}
+
+# Default place an asset is copied into, per kind, when the project has no
+# better convention. The agent is told it may choose a different folder if
+# the project already has one.
+DEFAULT_ASSET_DIR: Dict[str, str] = {
+    "image": "public/assets/images",
+    "model3d": "public/assets/models",
+    "font": "public/assets/fonts",
+    "video": "public/assets/video",
+    "audio": "public/assets/audio",
+    "data": "public/assets/data",
+}
+
+
+def classify_asset(filename: str) -> Optional[str]:
+    """Return the asset kind for a filename, or None if it is not an asset."""
+    if not filename:
+        return None
+    _, ext = os.path.splitext(filename.lower())
+    return _EXT_TO_KIND.get(ext)
+
+
+def is_asset(filename: str) -> bool:
+    return classify_asset(filename) is not None
+
+
+# ---------------------------------------------------------------------------
+# Request intent
+# ---------------------------------------------------------------------------
+
+_PROBLEM_RE = re.compile(
+    r"\b(error|errors|bug|bugs|broken|not working|doesn'?t work|does not work|"
+    r"fix|fixes|fixed|issue|issues|problem|problems|crash|crashes|crashing|"
+    r"traceback|exception|fails|failing|failed|wrong|undefined|blank)\b",
+    re.IGNORECASE,
+)
+
+_ALL_FILES_RE = re.compile(
+    r"\b(all (the )?files|every file|list (all |the )?files|show (all |the )?files|"
+    r"full (file )?tree|entire (repo|repository|project)|whole (repo|repository|project)|"
+    r"file tree|project structure)\b",
+    re.IGNORECASE,
+)
+
+
+def request_intent(text: str) -> str:
+    """Classify a user message as 'list_all', 'fix', or 'normal'.
+
+    'list_all' wins over 'fix' because an explicit request for the full file
+    list should always be honoured, even if the message also mentions a bug.
+    """
+    if not text:
+        return "normal"
+    if _ALL_FILES_RE.search(text):
+        return "list_all"
+    if _PROBLEM_RE.search(text):
+        return "fix"
+    return "normal"
+
+
+def mentioned_files(text: str, candidates: Iterable[str]) -> List[str]:
+    """Return candidate paths whose basename or path appears in the text.
+
+    Used on problem reports so a stack trace or message that names a file
+    (e.g. 'src/App.jsx:12') pulls that file into the list even if it was
+    not edited this turn.
+    """
+    if not text:
+        return []
+    hits: List[str] = []
+    for path in candidates:
+        base = os.path.basename(path)
+        if path in text or (base and base in text):
+            hits.append(path)
+    return hits
+
+
+def select_files_for_response(
+    intent: str,
+    touched: Dict[str, str],
+    repo_files: Sequence[str],
+    user_text: str = "",
+) -> List[str]:
+    """Decide which files the UI should list for this turn.
+
+    - normal:   only files created or edited this turn.
+    - fix:      only files edited/fixed this turn, plus any file the user's
+                message explicitly names. Never the repo tree.
+    - list_all: everything: the files touched this turn and the full repo
+                listing, de-duplicated and in stable order.
+    """
+    touched_list = list(touched.keys())
+    if intent == "list_all":
+        seen: List[str] = []
+        for path in list(touched_list) + list(repo_files):
+            if path not in seen:
+                seen.append(path)
+        return seen
+    if intent == "fix":
+        extras = [p for p in mentioned_files(user_text, repo_files) if p not in touched_list]
+        return touched_list + extras
+    return touched_list
+
+
+# ---------------------------------------------------------------------------
+# Repo summaries (model context + UI), never the full tree by default
+# ---------------------------------------------------------------------------
+
+def summarize_repo(files: Sequence[str], readme: str = "", readme_chars: int = 1500) -> str:
+    """Return a short, bounded summary of a repo for model context.
+
+    Gives the file count, top-level folders, and a README excerpt. The full
+    file list is deliberately excluded so it is not dumped into the chat or
+    the planning prompt unless the user asks for it.
+    """
+    total = len(files)
+    tops = sorted({p.split("/", 1)[0] for p in files if "/" in p})
+    root_files = sorted(p for p in files if "/" not in p)
+    lines = [f"Repository: {total} files."]
+    if tops:
+        lines.append("Top-level folders: " + ", ".join(tops[:20]) + ("…" if len(tops) > 20 else ""))
+    if root_files:
+        lines.append("Root files: " + ", ".join(root_files[:20]) + ("…" if len(root_files) > 20 else ""))
+    if readme:
+        lines.append("README excerpt:\n" + readme.strip()[:readme_chars])
+    lines.append("(Full file list is available on request.)")
+    return "\n".join(lines)
