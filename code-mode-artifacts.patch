+REPO_FILE_LISTING_PATH = "/tmp/plan_repo_preview.files.txt"
+_REPO_LIST_MAX_FILES = 2000
+
+
+async def list_repo_files(session_id: str, timeout: float = 30.0) -> Tuple[int, List[str]]:
+    """Return the full file list of the last fetched repo. Only call this when
+    the user has explicitly asked to see all files."""
+    q = shlex.quote(REPO_FILE_LISTING_PATH)
+    exit_code, output = await run_command(
+        session_id, f"head -n {_REPO_LIST_MAX_FILES} {q} 2>/dev/null", cwd="/tmp", timeout=timeout
+    )
+    if exit_code != 0:
+        return exit_code, []
+    files = [line.strip() for line in (output or "").splitlines() if line.strip()]
+    return 0, files
